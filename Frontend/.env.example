# Leave empty for local development; Vite proxies /api to http://localhost:4000.
# Set the deployed backend URL here when deploying, for example https://api.example.com.
VITE_API_URL=

# EmailJS inquiry notifications. Set the template recipient to the studio inbox.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
