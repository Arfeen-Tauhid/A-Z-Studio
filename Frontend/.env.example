# Leave empty when using the Vercel /api rewrite or local Vite proxy.
# Set this only when the browser should call an API origin directly.
VITE_API_URL=

# EmailJS inquiry notifications. Set the template recipient to the studio inbox.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
